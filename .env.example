# Modo mock por defecto. false requiere configuración y servicios AWS reales.
VITE_DEMO_MODE=true

# Valores opcionales. Configura únicamente el número oficial de Siniestros Paramita
# y las horas de SLA aprobadas para cada etapa.
VITE_PARAMITA_CLAIMS_PHONE=
VITE_SLA_DOCUMENTS_HOURS=
VITE_SLA_REVIEW_HOURS=
VITE_SLA_INSURER_HOURS=
